// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  MOVIE
  TV
}

enum TrackingStatus {
  WATCHING    
  COMPLETED   
  DROPPED     
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  password     String         
  
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt      @map("updated_at")

  trackedMedia TrackedMedia[]
  watchlists   Watchlist[]

  @@map("users")
}

model Watchlist {
  id          String            @id @default(uuid())
  name        String            
  
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt      @map("updated_at")

  userId      String            @map("user_id")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       WatchlistItem[]

  @@unique([userId, name])
  @@map("watchlists")
}

model WatchlistItem {
  id          String      @id @default(uuid())
  tmdbId      Int         @map("tmdb_id")
  mediaType   MediaType   @map("media_type")
  
  title       String?     
  posterPath  String?     @map("poster_path")
  
  createdAt   DateTime    @default(now()) @map("created_at")

  watchlistId String      @map("watchlist_id")
  watchlist   Watchlist   @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, tmdbId, mediaType])
  @@map("watchlist_items")
}

model TrackedMedia {
  id          String         @id @default(uuid())
  tmdbId      Int            @map("tmdb_id")
  mediaType   MediaType      @map("media_type")
  status      TrackingStatus 

  title       String?
  posterPath  String?        @map("poster_path")
  
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")

  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  watchHistory WatchHistory[]

  @@unique([userId, tmdbId, mediaType])
  @@map("tracked_media")
}

model WatchHistory {
  id              String       @id @default(uuid())
  
  seasonNumber    Int?         @map("season_number")
  episodeNumber   Int?         @map("episode_number")
  
  watchedAt       DateTime     @default(now()) @map("watched_at")
  
  trackedMediaId  String       @map("tracked_media_id")
  trackedMedia    TrackedMedia @relation(fields: [trackedMediaId], references: [id], onDelete: Cascade)

  @@index([watchedAt(sort: Desc)])
  @@index([trackedMediaId])
  @@map("watch_histories")
}
